[Unit]
Description=Private English X research and pending drafts
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=45min
ExecStart=/bin/bash /opt/insight/twitter/deploy/run-research.sh
ExecStopPost=-/usr/bin/docker rm -f insight-twitter-daily
