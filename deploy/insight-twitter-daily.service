[Unit]
Description=Private English X research and pending drafts
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=20min
ExecStartPre=/usr/bin/python3 -B /opt/insight/twitter/pipeline/fetch_public.py /opt/insight/twitter/profiles /opt/insight/twitter/public-timelines.json
ExecStart=/usr/bin/docker run --rm --name insight-twitter-daily --network insight_insight-net --group-add 10001 --read-only --tmpfs /tmp:rw,nosuid,noexec,size=32m --cap-drop ALL --security-opt no-new-privileges --memory 256m --cpus 1 --env-file /opt/insight/twitter/.env.server -e XVS_TIMELINES_FILE=/app/public-timelines.json -v /opt/insight/twitter:/app:ro -v /opt/insight/twitter/profiles:/app/profiles:rw -w /app python:3.12-slim python -B pipeline/server_daily.py o2co bitoff
ExecStopPost=-/usr/bin/docker rm -f insight-twitter-daily
